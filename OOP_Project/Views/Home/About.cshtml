@{
    ViewData["Title"] = "About";
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
@await Html.PartialAsync("Partials/Header.cshtml")




<div class="container">
    <div class="image">
        <img src="~/css/images/index.png" alt="Airplane Window" />
    </div>
    <div class="text-box">
        <h6>ABOUT US</h6>
        <p>
            Welcome to our System,your trusted source  <br>
            for all things aviation,specializing in  <br>
            the essential components and mechanics of  <br>
