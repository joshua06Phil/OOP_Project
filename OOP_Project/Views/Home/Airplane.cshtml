@{
    ViewData["Title"] = "Airplanes";
}

<link rel="stylesheet" href="~/css/airplane.css" asp-append-version="true" />
<div class="footer">
    @await Html.PartialAsync("Partials/Header.cshtml")
</div>

<div class="airplane-container">
    <div class="airplane-h1">
        <h1>Airplanes</h1>
    </div>

</div>
<div class="menu">
    <button class="toggle-menu"> <img src="~/css/images/CESNA.gif" alt="CESNA" /></button>
    <ul class="menu-items">
        <li><a href="#">Engine</a></li>
        <li><a href="#">Propeller</a></li>
        <li><a href="#">Landing Gear</a></li>
        <li><a href="#">Fuselage</a></li>
        <li><a href="#">Cockpit</a></li>
        <li><a href="#">Wings</a></li>
        <li><a href="#">Tail</a></li>
        <li><a href="#">Wings</a></li>
    
    </ul>
</div>

<script src="js/script.js"></script>



<script>
    const toggleMenu = document.querySelector(".toggle-menu");
    const menu = document.querySelector(".menu");

    toggleMenu.addEventListener("click", () => {
        menu.classList.toggle("active");
    });
    </script>


<div class="footer">
       
@await Html.PartialAsync("Partials/Footer.cshtml")
</div>
<script src="~/js/quiz.js" asp-append-version="true"></script>